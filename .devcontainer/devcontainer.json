{
  "name": "Django Dev",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "web",
  "workspaceFolder": "/code",
  "postCreateCommand": "python manage.py migrate",
  "postAttachCommand": {
    "server": "python manage.py runserver 0.0.0.0:8000"
  },
  "forwardPorts": [8000],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
